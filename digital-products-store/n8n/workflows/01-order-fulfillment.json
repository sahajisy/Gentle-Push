{
  "name": "01 - Order Fulfillment",
  "nodes": [
    {
      "parameters": { "events": ["checkout.session.completed"] },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Stripe Checkout Completed",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "webhookId": "store-stripe-orders",
      "credentials": { "stripeApi": { "id": "REPLACE_ME", "name": "Stripe account" } }
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json.data.object;\nreturn [{ json: {\n  session_id: s.id,\n  payment_link_id: s.payment_link || '',\n  email: (s.customer_details && s.customer_details.email || '').trim().toLowerCase(),\n  customer_name: (s.customer_details && s.customer_details.name) || '',\n  amount: (s.amount_total || 0) / 100,\n  currency: (s.currency || '').toUpperCase(),\n  paid: s.payment_status === 'paid'\n} }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Normalize Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c-paid",
              "leftValue": "={{ $json.paid }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            },
            {
              "id": "c-email",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Paid With Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Orders" },
        "filtersUI": {
          "values": [
            { "lookupColumn": "session_id", "lookupValue": "={{ $json.session_id }}" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Find Existing Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [660, 200],
      "alwaysOutputData": true,
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c-new",
              "leftValue": "={{ $json.session_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Is New Order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Products" },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "stripe_payment_link_id",
              "lookupValue": "={{ $('Normalize Order').item.json.payment_link_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Lookup Product",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 100],
      "alwaysOutputData": true,
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c-sku",
              "leftValue": "={{ $json.sku }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            },
            {
              "id": "c-url",
              "leftValue": "={{ $json.supplier_download_url }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Product Mapped?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 100]
    },
    {
      "parameters": {
        "jsCode": "const order = $('Normalize Order').first().json;\nconst p = $input.first().json;\nconst esc = (t) => String(t).replace(/[&<>\"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst name = order.customer_name ? esc(order.customer_name.split(' ')[0]) : 'there';\nconst html = `<p>Hi ${name},</p>` +\n  `<p>Thanks for your purchase of <strong>${esc(p.title)}</strong>.</p>` +\n  `<p><a href=\"${esc(p.supplier_download_url)}\">Download your files</a></p>` +\n  (p.license_note ? `<p><small>License: ${esc(p.license_note)}</small></p>` : '') +\n  `<p>Need help? Just reply to this email. Order reference: ${esc(order.session_id)}</p>`;\nreturn [{ json: { to: order.email, subject: `Your download: ${p.title}`, html, sku: p.sku, title: p.title, amount: order.amount, currency: order.currency, session_id: order.session_id } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Build Delivery Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "fromEmail": "Store <orders@example.com>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Send Delivery Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1760, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": { "smtp": { "id": "REPLACE_ME", "name": "SMTP account" } }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Orders" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "session_id": "={{ $('Build Delivery Email').item.json.session_id }}",
            "created_at": "={{ $now.toISO() }}",
            "email": "={{ $('Build Delivery Email').item.json.to }}",
            "sku": "={{ $('Build Delivery Email').item.json.sku }}",
            "amount": "={{ $('Build Delivery Email').item.json.amount }}",
            "currency": "={{ $('Build Delivery Email').item.json.currency }}",
            "status": "delivered"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Log Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1980, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "=✅ Sale: {{ $('Build Delivery Email').item.json.title }} — {{ $('Build Delivery Email').item.json.amount }} {{ $('Build Delivery Email').item.json.currency }} to {{ $('Build Delivery Email').item.json.to }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Notify Owner - Sale",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2200, 0],
      "webhookId": "store-telegram-sale",
      "credentials": { "telegramApi": { "id": "REPLACE_ME", "name": "Telegram bot" } }
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "=⚠️ PAID ORDER NOT FULFILLED — no product mapped (or no supplier URL) for payment link {{ $('Normalize Order').item.json.payment_link_id }}. Customer: {{ $('Normalize Order').item.json.email }}, session {{ $('Normalize Order').item.json.session_id }}. Fulfil manually.",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Alert Owner - Unmapped",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 220],
      "webhookId": "store-telegram-unmapped",
      "credentials": { "telegramApi": { "id": "REPLACE_ME", "name": "Telegram bot" } }
    }
  ],
  "connections": {
    "Stripe Checkout Completed": { "main": [[{ "node": "Normalize Order", "type": "main", "index": 0 }]] },
    "Normalize Order": { "main": [[{ "node": "Paid With Email?", "type": "main", "index": 0 }]] },
    "Paid With Email?": { "main": [[{ "node": "Find Existing Order", "type": "main", "index": 0 }], []] },
    "Find Existing Order": { "main": [[{ "node": "Is New Order?", "type": "main", "index": 0 }]] },
    "Is New Order?": { "main": [[{ "node": "Lookup Product", "type": "main", "index": 0 }], []] },
    "Lookup Product": { "main": [[{ "node": "Product Mapped?", "type": "main", "index": 0 }]] },
    "Product Mapped?": {
      "main": [
        [{ "node": "Build Delivery Email", "type": "main", "index": 0 }],
        [{ "node": "Alert Owner - Unmapped", "type": "main", "index": 0 }]
      ]
    },
    "Build Delivery Email": { "main": [[{ "node": "Send Delivery Email", "type": "main", "index": 0 }]] },
    "Send Delivery Email": { "main": [[{ "node": "Log Order", "type": "main", "index": 0 }]] },
    "Log Order": { "main": [[{ "node": "Notify Owner - Sale", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
