        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Needs Description?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        380
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a product description for an online store listing.\n\nTitle: {{ $json.title }}\nCategory: {{ $json.category }}\nNotes: {{ $json.license_note }}\n\nRules: 2 short sentences, max 40 words, plain text, no emojis, no hype, no claims you cannot verify from the title/category (no invented page counts, ratings or features). Output only the description."
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Write Description",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        700,
        280
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5-5"
        },
        "options": {
          "temperature": 0.4,
          "maxTokensToSample": 200
        }
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        720,
        480
      ],
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_ME",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Products"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "sku": "={{ $('Needs Description?').item.json.sku }}",
            "description": "={{ $json.text.trim() }}"
          },
          "matchingColumns": [
            "sku"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000007",
      "name": "Save Description",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1000,
        280
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "c3000000-0000-4000-8000-000000000010",
      "name": "Join Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1240,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Rebuild the public catalog from the sheet. Descriptions just written by the AI\n// are merged in by sku. supplier_download_url is deliberately never published.\nconst generated = {};\ntry {\n  for (const it of $('Save Description').all()) {\n    generated[it.json.sku] = it.json.description;\n  }\n} catch (e) { /* no descriptions were generated this run */ }\nconst rows = $('Read Products').all().map((i) => i.json);\nconst isOn = (v) => ['true', '1', 'yes'].includes(String(v).trim().toLowerCase());\nconst products = rows\n  .filter((r) => r.sku && r.title && isOn(r.active))\n  .map((r) => ({\n    sku: String(r.sku),\n    title: String(r.title),\n    category: String(r.category || ''),\n    price: Number(r.price),\n    currency: String(r.currency || 'USD').toUpperCase(),\n    description: String(r.description || generated[r.sku] || ''),\n    image: String(r.image_url || ''),\n    checkoutUrl: String(r.stripe_payment_link_url || ''),\n    license: String(r.license_note || ''),\n  }))\n  .filter((p) => Number.isFinite(p.price));\nconst content = JSON.stringify({ updated: new Date().toISOString(), products }, null, 2) + '\\n';\nreturn [{ json: { content, count: products.length } }];"
      },
      "id": "c3000000-0000-4000-8000-000000000008",
      "name": "Build Public Catalog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        380
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "edit",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "REPLACE_WITH_GITHUB_OWNER"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Gentle-Push"
        },
        "filePath": "digital-products-store/site/products.json",
        "fileContent": "={{ $json.content }}",
        "commitMessage": "=chore: sync catalog ({{ $json.count }} products)",
        "additionalParameters": {
          "branch": {
            "branch": "main"
          }
        }
      },
      "id": "c3000000-0000-4000-8000-000000000009",
      "name": "Commit products.json",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1680,
        380
      ],
      "credentials": {
        "githubApi": {
          "id": "REPLACE_ME",
          "name": "GitHub account"
        }
      }
    }
  ],
